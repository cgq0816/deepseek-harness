{
  "name": "@deepseek-ai/dsh-coagents-enterprise",
  "version": "0.1.7-rc.1",
  "description": "Enterprise identity, managed models, skills, connectors, documents, and dynamic MCP for DSH",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/skills",
    "lib/types/**/*.d.ts"
  ],
  "dshCompatibility": {
    "runtimeBaseline": "0.1.5-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/mod/coagents-enterprise"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-mcp-client": "workspace:*",
    "@deepseek-ai/dsh-settings": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-skill": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-user-approval": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
